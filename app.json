{
  "expo": {
    "name": "SONNO",
    "slug": "sonno-sleep-music",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sonno_splash_icon.png",
    "scheme": "music",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sonno_splash_icon.png",
        "backgroundColor": "#181A20"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sonno.music",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sonno_splash_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#181A20"
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9625cf8-cb35-4e8a-a1ed-5a16ae0f03fa"
      }
    }
  }
}
